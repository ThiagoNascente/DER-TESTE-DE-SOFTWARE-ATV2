SQL> CREATE TABLE ats_pedido (
  2    pedido_id      NUMBER GENERATED BY DEFAULT AS IDENTITY,
  3    cliente_id     NUMBER NOT NULL,
  4    endereco_id    NUMBER NOT NULL,
  5    data_pedido    DATE DEFAULT SYSDATE NOT NULL,
  6    status_pedido  VARCHAR2(12) DEFAULT 'ABERTO' NOT NULL,
  7    valor_total    NUMBER(12,2) NOT NULL,
  8    CONSTRAINT pk_ats_pedido PRIMARY KEY (pedido_id),
  9    CONSTRAINT uk_ats_pedido_id_total UNIQUE (pedido_id, valor_total),
 10    CONSTRAINT fk_ats_pedido_cliente FOREIGN KEY (cliente_id) REFERENCES ats_cliente (cliente_id),
 11    CONSTRAINT fk_ats_pedido_end_cli FOREIGN KEY (endereco_id, cliente_id)
 12  	 REFERENCES ats_endereco (endereco_id, cliente_id),
 13    CONSTRAINT ck_ats_pedido_status CHECK (status_pedido IN ('ABERTO', 'PAGO', 'ENVIADO', 'ENTREGUE', 'CANCELADO')),
 14    CONSTRAINT ck_ats_pedido_total CHECK (valor_total BETWEEN 0 AND 9999999999.99)
 15  );

