  8    CONSTRAINT ck_ats_categoria_nome CHECK (LENGTH(TRIM(nome)) BETWEEN 3 AND 80),
  9    CONSTRAINT ck_ats_categoria_ativo CHECK (ativo IN ('S', 'N'))
 10  );

