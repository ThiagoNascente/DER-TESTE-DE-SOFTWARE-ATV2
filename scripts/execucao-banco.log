SQL> CREATE TABLE ats_entrega (
  2    entrega_id	NUMBER GENERATED BY DEFAULT AS IDENTITY,
  3    pedido_id	NUMBER NOT NULL,
  4    transportadora	VARCHAR2(80) NOT NULL,
  5    codigo_rastreio	VARCHAR2(40),
  6    status_entrega	VARCHAR2(12) DEFAULT 'PREPARANDO' NOT NULL,
  7    data_envio	DATE,
  8    data_prevista	DATE,
  9    data_entrega	DATE,
 10    CONSTRAINT pk_ats_entrega PRIMARY KEY (entrega_id),
 11    CONSTRAINT uk_ats_entrega_pedido UNIQUE (pedido_id),
 12    CONSTRAINT uk_ats_entrega_rastreio UNIQUE (codigo_rastreio),
 13    CONSTRAINT fk_ats_entrega_pedido FOREIGN KEY (pedido_id) REFERENCES ats_pedido (pedido_id),
 14    CONSTRAINT ck_ats_entrega_status CHECK (status_entrega IN ('PREPARANDO', 'ENVIADO', 'ENTREGUE', 'DEVOLVIDO')),
 15    CONSTRAINT ck_ats_entrega_prev CHECK (data_prevista IS NULL OR data_envio IS NULL OR data_prevista >= data_envio),
 16    CONSTRAINT ck_ats_entrega_data CHECK (data_entrega IS NULL OR (data_envio IS NOT NULL AND data_entrega >= data_envio)),
 17    CONSTRAINT ck_ats_entrega_concl CHECK (status_entrega <> 'ENTREGUE' OR data_entrega IS NOT NULL)
 18  );

