SQL> CREATE TABLE ats_item_pedido (
  2    pedido_id	   NUMBER NOT NULL,
  3    produto_id	   NUMBER NOT NULL,
  4    quantidade	   NUMBER(3) NOT NULL,
  5    preco_unitario	   NUMBER(12,2) NOT NULL,
  6    desconto_percentual NUMBER(5,2) DEFAULT 0 NOT NULL,
  7    CONSTRAINT pk_ats_item_pedido PRIMARY KEY (pedido_id, produto_id),
  8    CONSTRAINT fk_ats_item_pedido FOREIGN KEY (pedido_id) REFERENCES ats_pedido (pedido_id),
  9    CONSTRAINT fk_ats_item_produto FOREIGN KEY (produto_id) REFERENCES ats_produto (produto_id),
 10    CONSTRAINT ck_ats_item_qtd CHECK (quantidade BETWEEN 1 AND 999 AND quantidade = TRUNC(quantidade)),
 11    CONSTRAINT ck_ats_item_preco CHECK (preco_unitario BETWEEN 0.01 AND 999999.99),
 12    CONSTRAINT ck_ats_item_desconto CHECK (desconto_percentual BETWEEN 0 AND 100)
 13  );

