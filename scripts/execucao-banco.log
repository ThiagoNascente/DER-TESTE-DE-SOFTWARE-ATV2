SQL> CREATE TABLE ats_cliente (
  2    cliente_id	NUMBER GENERATED BY DEFAULT AS IDENTITY,
  3    nome		VARCHAR2(100) NOT NULL,
  4    email		VARCHAR2(150) NOT NULL,
  5    telefone 	VARCHAR2(11),
  6    data_nascimento	DATE NOT NULL,
  7    status_cliente	CHAR(1) DEFAULT 'A' NOT NULL,
  8    CONSTRAINT pk_ats_cliente PRIMARY KEY (cliente_id),
  9    CONSTRAINT uk_ats_cliente_email UNIQUE (email),
 10    CONSTRAINT ck_ats_cliente_nome CHECK (LENGTH(TRIM(nome)) BETWEEN 3 AND 100),
 11    CONSTRAINT ck_ats_cliente_email CHECK (REGEXP_LIKE(email, '^[^@ ]+@[^@ ]+[.][^@ ]+$')),
 12    CONSTRAINT ck_ats_cliente_tel CHECK (telefone IS NULL OR REGEXP_LIKE(telefone, '^[0-9]{10,11}$')),
 13    CONSTRAINT ck_ats_cliente_nasc CHECK (data_nascimento BETWEEN DATE '1900-01-01' AND DATE '2008-09-26'),
 14    CONSTRAINT ck_ats_cliente_status CHECK (status_cliente IN ('A', 'I'))
 15  );

Table created.

SQL> 
SQL> CREATE TABLE ats_endereco (
  2    endereco_id    NUMBER GENERATED BY DEFAULT AS IDENTITY,
  3    cliente_id     NUMBER NOT NULL,
  4    tipo_endereco  VARCHAR2(12) NOT NULL,
  5    logradouro     VARCHAR2(150) NOT NULL,
  6    numero	      NUMBER(6) NOT NULL,
  7    complemento    VARCHAR2(60),
  8    cep	      CHAR(8) NOT NULL,
  9    cidade	      VARCHAR2(80) NOT NULL,
 10    uf	      CHAR(2) NOT NULL,
 11    CONSTRAINT pk_ats_endereco PRIMARY KEY (endereco_id),
 12    CONSTRAINT uk_ats_endereco_cli UNIQUE (endereco_id, cliente_id),
 13    CONSTRAINT fk_ats_endereco_cliente FOREIGN KEY (cliente_id) REFERENCES ats_cliente (cliente_id),
 14    CONSTRAINT ck_ats_endereco_tipo CHECK (tipo_endereco IN ('RESIDENCIAL', 'COMERCIAL')),
 15    CONSTRAINT ck_ats_endereco_logr CHECK (LENGTH(TRIM(logradouro)) BETWEEN 3 AND 150),
 16    CONSTRAINT ck_ats_endereco_num CHECK (numero BETWEEN 1 AND 999999 AND numero = TRUNC(numero)),
 17    CONSTRAINT ck_ats_endereco_cep CHECK (REGEXP_LIKE(cep, '^[0-9]{8}$')),
 18    CONSTRAINT ck_ats_endereco_uf CHECK (REGEXP_LIKE(uf, '^[A-Z]{2}$'))
 19  );

Table created.

