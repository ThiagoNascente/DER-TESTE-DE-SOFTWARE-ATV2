SQL> CREATE TABLE ats_pagamento (
  2    pagamento_id	 NUMBER GENERATED BY DEFAULT AS IDENTITY,
  3    pedido_id	 NUMBER NOT NULL,
  4    forma_pagamento	 VARCHAR2(12) NOT NULL,
  5    valor		 NUMBER(12,2) NOT NULL,
  6    parcelas 	 NUMBER(2) DEFAULT 1 NOT NULL,
  7    status_pagamento  VARCHAR2(12) DEFAULT 'PENDENTE' NOT NULL,
  8    data_pagamento	 DATE DEFAULT SYSDATE NOT NULL,
  9    CONSTRAINT pk_ats_pagamento PRIMARY KEY (pagamento_id),
 10    CONSTRAINT uk_ats_pagamento_pedido UNIQUE (pedido_id),
 11    CONSTRAINT fk_ats_pagamento_pedido FOREIGN KEY (pedido_id) REFERENCES ats_pedido (pedido_id),
 12    CONSTRAINT fk_ats_pagamento_total FOREIGN KEY (pedido_id, valor)
 13  	 REFERENCES ats_pedido (pedido_id, valor_total),
 14    CONSTRAINT ck_ats_pagamento_forma CHECK (forma_pagamento IN ('PIX', 'CARTAO', 'BOLETO', 'DINHEIRO')),
 15    CONSTRAINT ck_ats_pagamento_valor CHECK (valor BETWEEN 0.01 AND 9999999999.99),
 16    CONSTRAINT ck_ats_pagamento_parc CHECK (parcelas BETWEEN 1 AND 12 AND parcelas = TRUNC(parcelas)),
 17    CONSTRAINT ck_ats_pagamento_status CHECK (status_pagamento IN ('PENDENTE', 'APROVADO', 'RECUSADO', 'ESTORNADO'))
 18  );

