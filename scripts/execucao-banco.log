SQL> CREATE TABLE ats_produto (
  2    produto_id    NUMBER GENERATED BY DEFAULT AS IDENTITY,
  3    categoria_id  NUMBER NOT NULL,
  4    sku	     VARCHAR2(20) NOT NULL,
  5    nome	     VARCHAR2(120) NOT NULL,
  6    preco	     NUMBER(12,2) NOT NULL,
  7    estoque	     NUMBER(8) DEFAULT 0 NOT NULL,
  8    ativo	     CHAR(1) DEFAULT 'S' NOT NULL,
  9    CONSTRAINT pk_ats_produto PRIMARY KEY (produto_id),
 10    CONSTRAINT uk_ats_produto_sku UNIQUE (sku),
 11    CONSTRAINT fk_ats_produto_categoria FOREIGN KEY (categoria_id) REFERENCES ats_categoria (categoria_id),
 12    CONSTRAINT ck_ats_produto_nome CHECK (LENGTH(TRIM(nome)) BETWEEN 3 AND 120),
 13    CONSTRAINT ck_ats_produto_preco CHECK (preco BETWEEN 0.01 AND 999999.99),
 14    CONSTRAINT ck_ats_produto_estoque CHECK (estoque BETWEEN 0 AND 99999999 AND estoque = TRUNC(estoque)),
 15    CONSTRAINT ck_ats_produto_ativo CHECK (ativo IN ('S', 'N'))
 16  );

