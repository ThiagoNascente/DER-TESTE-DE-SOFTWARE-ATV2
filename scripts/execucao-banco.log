SQL> BEGIN
  2    FOR t IN (
  3  	 SELECT 'ATS_ENTREGA' table_name, 1 ordem FROM dual UNION ALL
  4  	 SELECT 'ATS_PAGAMENTO', 2 FROM dual UNION ALL
  5  	 SELECT 'ATS_ITEM_PEDIDO', 3 FROM dual UNION ALL
  6  	 SELECT 'ATS_PEDIDO', 4 FROM dual UNION ALL
  7  	 SELECT 'ATS_PRODUTO', 5 FROM dual UNION ALL
  8  	 SELECT 'ATS_CATEGORIA', 6 FROM dual UNION ALL
  9  	 SELECT 'ATS_ENDERECO', 7 FROM dual UNION ALL
 10  	 SELECT 'ATS_CLIENTE', 8 FROM dual
 11  	 ORDER BY ordem
 12    ) LOOP
 13  	 BEGIN
 14  	   EXECUTE IMMEDIATE 'DROP TABLE ' || t.table_name || ' CASCADE CONSTRAINTS PURGE';
 15  	 EXCEPTION
 16  	   WHEN OTHERS THEN
 17  	     IF SQLCODE != -942 THEN
 18  	       RAISE;
 19  	     END IF;
 20  	 END;
 21    END LOOP;
 22  END;
 23  /

